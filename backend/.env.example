# I-copy ito sa ".env" at palitan ang value.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase connection string (Session pooler) - galing sa Supabase > Connect
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-xxx.pooler.supabase.com:5432/postgres
DB_SSL=true

# Gumawa ng sarili mo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=palitan-ito-ng-mahabang-random-na-text

# ---------- Email verification (Gmail SMTP) ----------
# 1) Sa Gmail account na gagamitin mong "pang-send": i-on ang 2-Step Verification
# 2) Pumunta sa https://myaccount.google.com/apppasswords at gumawa ng App Password (16 characters)
# 3) Ilagay dito. HUWAG ang normal mong Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraccount@gmail.com
SMTP_PASS=abcdefghijklmnop
MAIL_FROM="PasalubongHub <youraccount@gmail.com>"

# ---------- Push notifications ----------
# Gumawa ng keys:  npm run push:keys   (ilagay ang dalawa dito)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:youraccount@gmail.com
